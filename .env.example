# ==========================================
# VANTAGE BRIDGE CONFIGURATION
# ==========================================
# Rename this file to '.env' and fill in your details.

# --- Vantage Controller Connection ---
VANTAGE_HOST=192.168.1.x
VANTAGE_USER=
VANTAGE_PASS=

# --- MQTT Broker Connection ---
# If using Home Assistant OS, host is often 'core-mosquitto'
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS_ENABLED=false

# --- Optional stateful Vantage task switches ---
# Comma-separated exact task names. The bridge discovers their numeric IDs and
# exposes only uniquely named matches as controllable Home Assistant switches.
# Leave empty unless a task represents a persistent mode rather than a scene.
# Example: TASK_SWITCH_NAMES=Travel,Vacation
TASK_SWITCH_NAMES=

# --- Debugging ---
# LOG_LEVEL (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
